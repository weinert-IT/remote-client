+//! Update channel of the branded build (remote-client repo).
+//!
+//! The API server decides which release a device gets (rollout per group,
+//! "update now" from the admin UI) and answers with the file to download. It
+//! cannot make the device run anything else: every offer carries an ed25519
+//! signature over version, build, platform, format, size and SHA-256, made in
+//! the release build with a key whose public half is compiled in here. A
+//! download that does not match the signed size and hash is discarded.
+//!
+//! Request (POST {api-server}/api/client/update):
+//!   {"id", "uuid", "version", "build", "os", "arch", "format", "manual"}
+//! Response: {} when there is nothing to do, else
+//!   {"version", "build", "url", "size", "sha256", "signature"}
+use crate::hbbs_http::create_http_client_with_url_strict;
+use hbb_common::{
+    anyhow::{anyhow, Context},
+    bail,
+    base64::{engine::general_purpose::STANDARD, Engine as _},
+    config::{self, Config},
+    log,
+    sodiumoxide::crypto::sign,
+    ResultType,
+};
+use serde_derive::Deserialize;
+use sha2::{Digest, Sha256};
+use std::{io::Write, path::PathBuf};
+
+/// Build number of this release (the CI run), on top of crate::VERSION.
+pub const BUILD: &str = match option_env!("BRAND_BUILD") {
+    Some(b) => b,
+    None => "0",
+};
+
+const SIGNING_CONTEXT: &str = "weinert-it remote-client update v1";
+const MAX_UPDATE_SIZE: u64 = 512 << 20;
+
+pub fn build_number() -> u64 {
+    BUILD.parse().unwrap_or(0)
+}
+
+#[derive(Debug, Deserialize)]
+pub struct Offer {
+    pub version: String,
+    pub build: u64,
+    pub url: String,
+    pub size: u64,
+    pub sha256: String,
+    pub signature: String,
+}
+
+fn hard_setting(key: &str) -> String {
+    config::HARD_SETTINGS
+        .read()
+        .unwrap()
+        .get(key)
+        .cloned()
+        .unwrap_or_default()
+}
+
+fn update_url() -> String {
+    let url = hard_setting("update-url");
+    if !url.is_empty() {
+        return url;
+    }
+    let api = crate::common::get_api_server(
+        Config::get_option("api-server"),
+        Config::get_option("custom-rendezvous-server"),
+    );
+    if api.is_empty() {
+        return "".to_owned();
+    }
+    format!("{}/api/client/update", api.trim_end_matches('/'))
+}
+
+fn public_key() -> ResultType<sign::PublicKey> {
+    let b64 = hard_setting("update-public-key");
+    let bytes = STANDARD
+        .decode(b64.trim())
+        .context("update-public-key is not base64")?;
+    sign::PublicKey::from_slice(&bytes).ok_or_else(|| anyhow!("invalid update-public-key"))
+}
+
+/// The exact text the release build signs (see sign_release.py).
+pub fn signed_message(version: &str, build: u64, arch: &str, format: &str, size: u64, sha256: &str) -> String {
+    format!(
+        "{SIGNING_CONTEXT}\n{version}\n{build}\n{os}\n{arch}\n{format}\n{size}\n{sha256}",
+        os = std::env::consts::OS,
+        sha256 = sha256.to_lowercase(),
+    )
+}
+
+fn verify_signature(offer: &Offer, format: &str) -> ResultType<()> {
+    let sig = STANDARD
+        .decode(offer.signature.trim())
+        .context("update signature is not base64")?;
+    let sig = sign::Signature::from_bytes(&sig).map_err(|_| anyhow!("invalid update signature"))?;
+    let msg = signed_message(
+        &offer.version,
+        offer.build,
+        std::env::consts::ARCH,
+        format,
+        offer.size,
+        &offer.sha256,
+    );
+    if !sign::verify_detached(&sig, msg.as_bytes(), &public_key()?) {
+        bail!("update signature does not match");
+    }
+    Ok(())
+}
+
+/// Asks the API server for an update; None if there is none for this device.
+pub fn check(manual: bool, format: &str) -> ResultType<Option<Offer>> {
+    let url = update_url();
+    if url.is_empty() {
+        return Ok(None);
+    }
+    let body = serde_json::json!({
+        "id": Config::get_id(),
+        "uuid": crate::encode64(hbb_common::get_uuid()),
+        "version": crate::VERSION,
+        "build": build_number(),
+        "os": std::env::consts::OS,
+        "arch": std::env::consts::ARCH,
+        "format": format,
+        "manual": manual,
+    });
+    let resp = crate::post_request_sync(url, body.to_string(), "")?;
+    let v: serde_json::Value = serde_json::from_str(&resp).context("invalid update response")?;
+    if v.get("url").and_then(|u| u.as_str()).unwrap_or_default().is_empty() {
+        return Ok(None);
+    }
+    let offer: Offer = serde_json::from_value(v).context("invalid update offer")?;
+    if offer.version == crate::VERSION && offer.build == build_number() {
+        return Ok(None);
+    }
+    if offer.size == 0 || offer.size > MAX_UPDATE_SIZE {
+        bail!("update size out of range: {}", offer.size);
+    }
+    verify_signature(&offer, format)?;
+    Ok(Some(offer))
+}
+
+/// Downloads the offered file and checks it against the signed size and hash.
+pub fn download(offer: &Offer, format: &str) -> ResultType<PathBuf> {
+    let file_name = format!(
+        "{}-{}-b{}-{}.{}",
+        crate::get_app_name(),
+        offer.version,
+        offer.build,
+        std::env::consts::ARCH,
+        format
+    );
+    let file_path = std::env::temp_dir().join(file_name);
+    if file_path.is_file() && sha256_of_file(&file_path).ok().as_deref() == Some(&offer.sha256.to_lowercase()) {
+        return Ok(file_path);
+    }
+    let client = create_http_client_with_url_strict(&offer.url)?;
+    let resp = client.get(&offer.url).send()?;
+    if !resp.status().is_success() {
+        bail!("Failed to download the update: {}", resp.status());
+    }
+    let data = resp.bytes()?;
+    if data.len() as u64 != offer.size {
+        bail!("update size mismatch: {} != {}", data.len(), offer.size);
+    }
+    let hash = hex::encode(Sha256::digest(&data));
+    if hash != offer.sha256.to_lowercase() {
+        bail!("update hash mismatch");
+    }
+    let mut file = std::fs::File::create(&file_path)?;
+    file.write_all(&data)?;
+    log::info!("Update {} build {} downloaded to {:?}", offer.version, offer.build, file_path);
+    Ok(file_path)
+}
+
+fn sha256_of_file(path: &PathBuf) -> ResultType<String> {
+    let data = std::fs::read(path)?;
+    Ok(hex::encode(Sha256::digest(&data)))
+}
