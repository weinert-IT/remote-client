+/// Brand configuration compiled into this build (see the remote-client repo,
+/// brand/brand.json), in the same format as a custom client config but not
+/// signed: it is part of the binary, so nothing outside can swap it.
+const EMBEDDED_BRAND_CONFIG: &str = include_str!("../res/brand/custom.json");
+
+/// The name shown to users. The app name itself names files, services and the
+/// URI scheme and must stay alphanumeric with hyphens.
+/// Read straight from the embedded config, so it is right even before
+/// load_custom_client ran (the Windows runner asks for it at startup).
+pub fn get_app_display_name() -> String {
+    lazy_static::lazy_static! {
+        static ref DISPLAY_NAME: String =
+            serde_json::from_str::<std::collections::HashMap<String, serde_json::Value>>(
+                EMBEDDED_BRAND_CONFIG,
+            )
+            .ok()
+            .and_then(|m| m.get("app-display-name")?.as_str().map(|s| s.to_owned()))
+            .unwrap_or_default();
+    }
+    if DISPLAY_NAME.is_empty() {
+        get_app_name()
+    } else {
+        DISPLAY_NAME.clone()
+    }
+}
+
 pub fn load_custom_client() {
+    if !EMBEDDED_BRAND_CONFIG.trim().is_empty() && EMBEDDED_BRAND_CONFIG.trim() != "{}" {
+        match serde_json::from_str::<std::collections::HashMap<String, serde_json::Value>>(
+            EMBEDDED_BRAND_CONFIG,
+        ) {
+            Ok(data) => {
+                apply_custom_client(data);
+                return;
+            }
+            Err(e) => log::error!("Failed to parse the embedded brand config: {e}"),
+        }
+    }
     #[cfg(debug_assertions)]
     if let Ok(data) = std::fs::read_to_string("./custom.txt") {
         read_custom_client(data.trim());
