+/// A branded build takes over the ID of a RustDesk install on the same machine
+/// (hbb_common config: migrate_from_rustdesk), so RustDesk must not keep
+/// running with that ID. Its service is stopped and disabled, not removed, so
+/// the step can be undone.
+fn get_retire_rustdesk() -> String {
+    if crate::get_app_name() == "RustDesk" {
+        return "".to_owned();
+    }
+    "
+sc query RustDesk >nul 2>&1 && (
+sc stop RustDesk
+sc config RustDesk start= disabled
+taskkill /F /IM RustDesk.exe
+)
+"
+    .to_owned()
+}
