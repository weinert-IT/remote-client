+    // Branded build: a password that does not match locally may be an access
+    // ticket of an account (brand_access.rs). The server knows the ticket and
+    // returns the account's rights, which then hold for this connection only.
+    async fn validate_access_ticket(&mut self) -> AccessTicket {
+        let Some(grant) = crate::brand_access::verify(
+            &self.hash.salt,
+            &self.hash.challenge,
+            &self.lr.password,
+            self.lr.session_id,
+            &self.lr.my_id,
+        )
+        .await
+        else {
+            return AccessTicket::NoTicket;
+        };
+        // Per-connection rights are not supported on Android: only grant what
+        // does not need them (full rights, or the device's own settings).
+        #[cfg(target_os = "android")]
+        if grant.level == "view" {
+            return AccessTicket::Denied("View-only access is not supported on this device");
+        }
+        #[cfg(not(target_os = "android"))]
+        if grant.permissions != 0 {
+            let mut cp = ControlPermissions::new();
+            cp.permissions = grant.permissions;
+            self.apply_control_permissions(cp);
+        }
+        // The session kind was checked against the rights before the login.
+        let denied = if self.file_transfer.is_some()
+            && !Self::permission(keys::OPTION_ENABLE_FILE_TRANSFER, &self.control_permissions)
+        {
+            Some("No permission of file transfer")
+        } else if self.view_camera
+            && !Self::permission(keys::OPTION_ENABLE_CAMERA, &self.control_permissions)
+        {
+            Some("No permission of viewing camera")
+        } else if self.terminal
+            && !Self::permission(keys::OPTION_ENABLE_TERMINAL, &self.control_permissions)
+        {
+            Some("No permission of terminal")
+        } else if matches!(self.lr.union, Some(login_request::Union::PortForward(_)))
+            && !Self::permission(keys::OPTION_ENABLE_TUNNEL, &self.control_permissions)
+        {
+            Some("No permission of IP tunneling")
+        } else {
+            None
+        };
+        if let Some(msg) = denied {
+            return AccessTicket::Denied(msg);
+        }
+        self.set_conn_audit_primary_auth(ConnAuditPrimaryAuth::AccountTicket);
+        log::info!(
+            "access ticket of account {} accepted ({})",
+            grant.user,
+            grant.level
+        );
+        AccessTicket::Granted
+    }
+
+    #[cfg(not(target_os = "android"))]
+    fn apply_control_permissions(&mut self, cp: ControlPermissions) {
