+//! Access without password through an account (branded build).
+//!
+//! The API server (rd-api, access.go) decides which account may reach which
+//! device and with which rights. The controlling client asks it for a ticket
+//! for one device and uses the ticket as the password; RustDesk only ever sends
+//! sha256(sha256(password + salt) + challenge). The controlled device does not
+//! know the ticket: when a password does not match locally, it hands salt,
+//! challenge and answer to the server, which knows the tickets and answers
+//! with the account and its rights. Both requests use HTTPS with strict
+//! certificate checks, never the insecure TLS fallback.
+use crate::hbbs_http::create_http_client_with_url_strict;
+use hbb_common::{
+    base64::{engine::general_purpose::STANDARD, Engine as _},
+    bail,
+    config::{Config, LocalConfig},
+    log, tokio, ResultType,
+};
+use serde_derive::Deserialize;
+use serde_json::{json, Value};
+use std::time::Duration;
+
+const TIMEOUT: Duration = Duration::from_secs(5);
+
+/// What the server grants an account on this device.
+#[derive(Debug, Default, Deserialize)]
+pub struct Grant {
+    #[serde(default)]
+    pub ok: bool,
+    #[serde(default)]
+    pub user: String,
+    /// "device", "view" or "full" (rd-api access.go).
+    #[serde(default)]
+    pub level: String,
+    /// ControlPermissions.permissions: two bits per permission.
+    #[serde(default)]
+    pub permissions: u64,
+}
+
+fn api_url(path: &str) -> Option<String> {
+    let api = crate::common::get_api_server(
+        Config::get_option("api-server"),
+        Config::get_option("custom-rendezvous-server"),
+    );
+    if api.is_empty() {
+        return None;
+    }
+    Some(format!("{}{}", api.trim_end_matches('/'), path))
+}
+
+fn post(url: String, body: Value, token: Option<String>) -> ResultType<Value> {
+    let client = create_http_client_with_url_strict(&url)?;
+    let mut req = client.post(&url).timeout(TIMEOUT).json(&body);
+    if let Some(token) = token {
+        req = req.bearer_auth(token);
+    }
+    let resp = req.send()?;
+    let status = resp.status();
+    let v: Value = resp.json().unwrap_or_default();
+    if !status.is_success() {
+        bail!("{}: {}", status, v);
+    }
+    Ok(v)
+}
+
+// The blocking HTTP client must not run (or be dropped) on a runtime thread.
+async fn post_async(url: String, body: Value, token: Option<String>) -> ResultType<Value> {
+    tokio::task::spawn_blocking(move || post(url, body, token)).await?
+}
+
+/// Controlling side: a ticket for device `id`, if an account is logged in and
+/// may reach it without password.
+pub async fn request_ticket(id: &str) -> Option<String> {
+    let token = LocalConfig::get_option("access_token");
+    if token.is_empty() || id.is_empty() || !id.chars().all(|c| c.is_ascii_alphanumeric()) {
+        return None;
+    }
+    let url = api_url("/api/wit/access-ticket")?;
+    match post_async(url, json!({ "id": id }), Some(token)).await {
+        Ok(v) => v
+            .get("ticket")
+            .and_then(|t| t.as_str())
+            .filter(|t| !t.is_empty())
+            .map(|t| t.to_owned()),
+        Err(e) => {
+            // 403 for devices the account may not reach without password.
+            log::debug!("no access ticket for {}: {}", id, e);
+            None
+        }
+    }
+}
+
+/// Controlled side: whether `answer` was made from an access ticket for this
+/// device, and what it grants.
+pub async fn verify(
+    salt: &str,
+    challenge: &str,
+    answer: &[u8],
+    session_id: u64,
+    peer_id: &str,
+) -> Option<Grant> {
+    if answer.len() != 32 {
+        return None;
+    }
+    let url = api_url("/api/wit/access-ticket/verify")?;
+    let body = json!({
+        "id": Config::get_id(),
+        "uuid": crate::encode64(hbb_common::get_uuid()),
+        "session_id": session_id,
+        "peer_id": peer_id,
+        "salt": salt,
+        "challenge": challenge,
+        "answer": STANDARD.encode(answer),
+    });
+    match post_async(url, body, None).await {
+        Ok(v) => {
+            let grant: Grant = serde_json::from_value(v).ok()?;
+            if !grant.ok {
+                return None;
+            }
+            Some(grant)
+        }
+        Err(e) => {
+            log::warn!("access ticket check failed: {}", e);
+            None
+        }
+    }
+}
