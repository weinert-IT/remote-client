+/// Check (and on request install) from the settings page. Runs in the UI
+/// process; the installer asks for elevation like RustDesk's own update dialog.
+#[cfg(target_os = "windows")]
+pub fn check_from_ui(install: bool) -> ResultType<Option<Offer>> {
+    let format = if crate::platform::is_msi_installed()? { "msi" } else { "exe" };
+    let Some(offer) = check(true, format)? else {
+        return Ok(None);
+    };
+    if install {
+        let path = download(&offer, format)?;
+        let path = path.to_str().ok_or_else(|| anyhow!("invalid update file path"))?;
+        crate::platform::update_to(path)?;
+    }
+    Ok(Some(offer))
+}
