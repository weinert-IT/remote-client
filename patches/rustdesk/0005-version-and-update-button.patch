+
+/// Manual update check through the own update channel (brand_update.rs).
+class _BrandUpdate extends StatefulWidget {
+  const _BrandUpdate({Key? key}) : super(key: key);
+
+  @override
+  State<_BrandUpdate> createState() => _BrandUpdateState();
+}
+
+class _BrandUpdateState extends State<_BrandUpdate> {
+  static const _event = 'brand-update';
+  bool _busy = false;
+  bool _available = false;
+  String _text = '';
+
+  @override
+  void initState() {
+    super.initState();
+    platformFFI.registerEventHandler(_event, _event, (evt) async {
+      if (!mounted) return;
+      final next = '${evt['version']} (Build ${evt['build']})';
+      setState(() {
+        _busy = false;
+        _available = false;
+        switch (evt['state']) {
+          case 'none':
+            _text = translate('brand-update-none');
+            break;
+          case 'available':
+            _available = true;
+            _text = translate('brand-update-available').replaceAll('{}', next);
+            break;
+          case 'started':
+            _text = translate('brand-update-started');
+            break;
+          default:
+            _text = '${translate('brand-update-failed')}: ${evt['msg'] ?? ''}';
+        }
+      });
+    }, replace: true);
+  }
+
+  @override
+  void dispose() {
+    platformFFI.unregisterEventHandler(_event, _event);
+    super.dispose();
+  }
+
+  void _run(String key, String text) {
+    setState(() {
+      _busy = true;
+      _text = translate(text);
+    });
+    bind.mainSetCommon(key: key, value: '');
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Row(children: [
+      ElevatedButton(
+        onPressed: _busy
+            ? null
+            : () => _available
+                ? _run('brand-install-update', 'brand-update-downloading')
+                : _run('brand-check-update', 'brand-update-checking'),
+        child: Text(translate(
+            _available ? 'brand-update-install' : 'brand-update-check')),
+      ),
+      const SizedBox(width: 12),
+      if (_busy)
+        const SizedBox(
+                width: 16,
+                height: 16,
+                child: CircularProgressIndicator(strokeWidth: 2))
+            .marginOnly(right: 8),
+      Expanded(child: SelectionArea(child: Text(_text))),
+    ]).marginSymmetric(vertical: 8.0);
+  }
+}
