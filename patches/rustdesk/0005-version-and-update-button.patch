+            match crate::brand_update::check_from_ui(install) {
+                Ok(Some(offer)) => {
+                    let state = if install { "started" } else { "available" };
+                    data.insert("state", serde_json::json!(state));
+                    data.insert("version", serde_json::json!(offer.version));
+                    data.insert("build", serde_json::json!(offer.build));
+                }
+                Ok(None) => {
+                    data.insert("state", serde_json::json!("none"));
+                }
+                Err(e) => {
+                    log::error!("Update from the settings page failed: {}", e);
